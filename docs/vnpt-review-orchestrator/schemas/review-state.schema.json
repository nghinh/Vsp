{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewState",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "scope_id",
    "scope_source",
    "mode",
    "status",
    "pass_count",
    "open_issue_count_history",
    "latest_pass_id",
    "fresh_confirmation_pass_done"
  ],
  "properties": {
    "scope_id": { "type": "string", "minLength": 1 },
    "scope_source": {
      "type": "string",
      "enum": ["workspace-diff", "path-arg", "review-handoff", "manual", "agent"]
    },
    "mode": {
      "type": "string",
      "enum": ["diff", "full", "path-arg", "handoff", "manual"]
    },
    "status": {
      "type": "string",
      "enum": ["in_progress", "stalled", "complete", "failed"]
    },
    "pass_count": { "type": "integer", "minimum": 1 },
    "open_issue_count_history": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0 }
    },
    "latest_pass_id": { "type": "string", "minLength": 1 },
    "fresh_confirmation_pass_done": { "type": "boolean" },
    "latest_zero_issue_pass_id": { "type": ["string", "null"] },
    "closed_issue_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "open_issue_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "scope_resolution": { "type": "string" },
    "scope_policy": { "type": "string" }
  }
}
