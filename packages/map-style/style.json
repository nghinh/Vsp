{
  "version": 8,
  "name": "VSP Golf Course Style",
  "description": "Vietnam Smart Golf Platform — High-contrast outdoor golf course style",
  "glyphs": "https://fonts.openmaptiles.org/{fontstack}/{range}.pbf",
  "sprite": "https://fonts.openmaptiles.org/_sparkle/sprites",
  "sources": {
    "course-geometry": {
      "type": "vector",
      "tiles": [
        "https://tiles.vsp.vn/courses/{z}/{x}/{y}.mvt"
      ],
      "attribution": "© VSP Golf Platform"
    },
    "hole-overlay": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#0F172A"
      }
    },
    {
      "id": "fairway-fill",
      "type": "fill",
      "source": "course-geometry",
      "source-layer": "fairway",
      "paint": {
        "fill-color": "#166534",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "rough-fill",
      "type": "fill",
      "source": "course-geometry",
      "source-layer": "rough",
      "paint": {
        "fill-color": "#14532D",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "green-fill",
      "type": "fill",
      "source": "course-geometry",
      "source-layer": "green",
      "paint": {
        "fill-color": "#22C55E",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "bunker-fill",
      "type": "fill",
      "source": "course-geometry",
      "source-layer": "bunker",
      "paint": {
        "fill-color": "#D4A853",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "water-fill",
      "type": "fill",
      "source": "course-geometry",
      "source-layer": "water",
      "paint": {
        "fill-color": "#1D4ED8",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "penalty-area-fill",
      "type": "fill",
      "source": "course-geometry",
      "source-layer": "penalty_area",
      "paint": {
        "fill-color": "#9333EA",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "ob-fill",
      "type": "fill",
      "source": "course-geometry",
      "source-layer": "ob",
      "paint": {
        "fill-color": "#1E293B",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "cart-path-line",
      "type": "line",
      "source": "course-geometry",
      "source-layer": "cart_path",
      "paint": {
        "line-color": "#64748B",
        "line-width": 2.5,
        "line-opacity": 0.8,
        "line-dasharray": [4, 2]
      }
    },
    {
      "id": "hazard-boundary-line",
      "type": "line",
      "source": "course-geometry",
      "source-layer": "water",
      "paint": {
        "line-color": "#1E40AF",
        "line-width": 1.5,
        "line-opacity": 0.9
      }
    },
    {
      "id": "fairway-boundary-line",
      "type": "line",
      "source": "course-geometry",
      "source-layer": "fairway",
      "paint": {
        "line-color": "#15803D",
        "line-width": 1,
        "line-opacity": 0.6
      }
    },
    {
      "id": "landmark-symbol",
      "type": "symbol",
      "source": "course-geometry",
      "source-layer": "landmark",
      "layout": {
        "text-field": "{name}",
        "text-size": 12,
        "text-font": ["Open Sans Bold"],
        "text-color": "#F8FAFC",
        "text-halo-color": "#0F172A",
        "text-halo-width": 1.5
      },
      "paint": {
        "text-opacity": 0.9
      }
    },
    {
      "id": "tee-box-symbol",
      "type": "symbol",
      "source": "course-geometry",
      "source-layer": "tee",
      "layout": {
        "text-field": "{tee_name}",
        "text-size": 11,
        "text-font": ["Open Sans Semibold"],
        "text-color": "#FFFFFF",
        "text-halo-color": "#0F172A",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "pin-circle",
      "type": "circle",
      "source": "hole-overlay",
      "filter": ["==", ["get", "layerType"], "pin"],
      "paint": {
        "circle-color": "#EA580C",
        "circle-radius": 7,
        "circle-stroke-width": 2,
        "circle-stroke-color": "#FFFFFF"
      }
    },
    {
      "id": "pin-label",
      "type": "symbol",
      "source": "hole-overlay",
      "filter": ["==", ["get", "layerType"], "pin"],
      "layout": {
        "text-field": "🏁",
        "text-size": 18
      }
    },
    {
      "id": "golfer-circle",
      "type": "circle",
      "source": "hole-overlay",
      "filter": ["==", ["get", "layerType"], "golfer"],
      "paint": {
        "circle-color": "#3B82F6",
        "circle-radius": 9,
        "circle-stroke-width": 2.5,
        "circle-stroke-color": "#FFFFFF"
      }
    },
    {
      "id": "golfer-accuracy-circle",
      "type": "circle",
      "source": "hole-overlay",
      "filter": ["==", ["get", "layerType"], "golferAccuracy"],
      "paint": {
        "circle-color": "#3B82F6",
        "circle-radius": ["get", "radius"],
        "circle-opacity": 0.15,
        "circle-stroke-width": 0,
        "circle-stroke-opacity": 0
      }
    },
    {
      "id": "target-marker",
      "type": "circle",
      "source": "hole-overlay",
      "filter": ["==", ["get", "layerType"], "target"],
      "paint": {
        "circle-color": "#22D3EE",
        "circle-radius": 8,
        "circle-stroke-width": 2,
        "circle-stroke-color": "#FFFFFF"
      }
    },
    {
      "id": "target-label",
      "type": "symbol",
      "source": "hole-overlay",
      "filter": ["==", ["get", "layerType"], "target"],
      "layout": {
        "text-field": "◎",
        "text-size": 18
      }
    },
    {
      "id": "distance-ring-100",
      "type": "line",
      "source": "hole-overlay",
      "filter": ["==", ["get", "layerType"], "distanceRing100"],
      "paint": {
        "line-color": "#F8FAFC",
        "line-width": 1,
        "line-opacity": 0.5,
        "line-dasharray": [3, 3]
      }
    },
    {
      "id": "distance-ring-150",
      "type": "line",
      "source": "hole-overlay",
      "filter": ["==", ["get", "layerType"], "distanceRing150"],
      "paint": {
        "line-color": "#F8FAFC",
        "line-width": 1,
        "line-opacity": 0.4,
        "line-dasharray": [3, 3]
      }
    },
    {
      "id": "distance-ring-200",
      "type": "line",
      "source": "hole-overlay",
      "filter": ["==", ["get", "layerType"], "distanceRing200"],
      "paint": {
        "line-color": "#F8FAFC",
        "line-width": 1,
        "line-opacity": 0.3,
        "line-dasharray": [3, 3]
      }
    },
    {
      "id": "wind-arrow",
      "type": "symbol",
      "source": "hole-overlay",
      "filter": ["==", ["get", "layerType"], "wind"],
      "layout": {
        "icon-image": "triangle-15",
        "icon-rotate": ["get", "direction"],
        "icon-rotation-alignment": "map",
        "icon-allow-overlap": true,
        "text-field": "{speed}",
        "text-size": 10,
        "text-font": ["Open Sans Bold"],
        "text-color": "#38BDF8",
        "text-offset": [0, 1.2]
      }
    }
  ],
  "metadata": {
    "vsp:version": "0.1.0",
    "vsp:status": "wave1",
    "vsp:style": "high-contrast-outdoor",
    "mapbox:groups": {}
  }
}
