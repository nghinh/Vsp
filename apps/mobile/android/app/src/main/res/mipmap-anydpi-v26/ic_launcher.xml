<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon, API 26+.

  Without this file the launcher takes the square ic_launcher.png and applies
  its own mask to it, which crops the corners off a full-bleed square. With it,
  the mark sits on its own layer inside the safe zone and the launcher masks
  only the background.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
