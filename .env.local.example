# Vietnam Smart Golf Platform — Environment Variable Template
# DO NOT commit this file with real values. Copy to .env.local and fill in secrets.
# Real values are injected at runtime. NEVER commit .env.local to version control.
#
# How to use:
#   cp .env.local.example .env.local
#   # Edit .env.local with your values
#

# ============================================
# Database (PostgreSQL + PostGIS via Docker)
# ============================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Database name — matches POSTGRES_DB in docker-compose.yaml
DATABASE_NAME=vsp
# Database user — matches POSTGRES_USER in docker-compose.yaml
DATABASE_USER=vsp
# Database password — matches POSTGRES_PASSWORD in docker-compose.yaml
# Default dev password is 'vsp_dev_password' (DO NOT use in production)
DATABASE_PASSWORD=vsp_dev_password

# ============================================
# Redis (via Docker)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis password (default: no password in local dev)
REDIS_PASSWORD=

# ============================================
# API Server
# ============================================
API_HOST=localhost
API_PORT=8080
API_BASE_URL=http://localhost:8080

# ============================================
# Mobile App
# ============================================
MOBILE_API_BASE_URL=http://localhost:8080

# ============================================
# Authentication / Secrets
# ============================================
# JWT secret — generate with: openssl rand -base64 32
JWT_SECRET=
# Session secret — generate with: openssl rand -base64 32
SESSION_SECRET=
# Encryption key for sensitive data — generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# ============================================
# Feature Flags
# ============================================
# ENABLE_FEATURE_X=false

