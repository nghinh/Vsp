# ─── Secrets / local env ──────────────────────────────────────────────────────
.env.local
.env*.local
*.pem
*.key
# (keep .env.local.example — it is a template)

# ─── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
*.swp

# ─── Node / Vite (portal) ─────────────────────────────────────────────────────
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ─── Java / Maven (api) ───────────────────────────────────────────────────────
# Scoped to the Maven module. A bare `target/` also matched
# apps/mobile/lib/features/target/ — a Flutter feature — and silently kept its
# source out of git. Keep build-output rules anchored to the app that produces
# them; "target", "build" and "dist" are all ordinary domain words elsewhere.
apps/api/**/target/
*.class

# ─── Flutter / Dart (mobile, watch_apple) ─────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
.packages
*.lock.tmp
ios/Pods/
ios/.symlinks/
android/.gradle/
android/local.properties

# ─── Gradle / Kotlin (wear-os) ────────────────────────────────────────────────
.gradle/
local.properties

# ─── Signing secrets ──────────────────────────────────────────────────────────
# Release keystores and the properties file that holds their password. See
# SECRETS_POLICY.md and apps/mobile/android/key.properties.example.
key.properties
*.jks
*.keystore
*.p12
*.mobileprovision

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Tooling caches / regenerable indexes ─────────────────────────────────────
.gitnexus/
.runtime/
.serena/

# ─── Python (tools) ────────────────────────────────────────────────────────────
__pycache__/
*.pyc
venv/
.venv/
